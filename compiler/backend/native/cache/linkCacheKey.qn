pub LinkCacheKey {
  inputSetHash: string
  executableHash: string
  targetTriple: string
  targetOptionsHash: string
  cacheKey: string
  diagnosticCode: string = ""
}

impl LinkCacheKey {
  pub LinkCacheKey(
    inputSetHash: string,
    executableHash: string,
    targetTriple: string,
    targetOptionsHash: string,
    cacheKey: string
  ) =
    This {
      inputSetHash
      executableHash
      targetTriple
      targetOptionsHash
      cacheKey
    }

  pub fromLinker(inputSet: LinkInputSet, executable: Executable) =
    This {
      inputSetHash: inputSet.inputSetHash
      executableHash: executable.executableHash
      targetTriple: executable.targetTriple
      targetOptionsHash: inputSet.targetOptionsHash
      cacheKey: "native-link-cache:{inputSet.inputSetHash}:{executable.executableHash}:{executable.targetTriple}:{inputSet.targetOptionsHash}"
      diagnosticCode: match inputSet.valid && executable.valid {
        true => ""
        false => "QNATIVE0850"
      }
    }
}

impl view LinkCacheKey {
  pub valid => diagnosticCode == "" &&
    inputSetHash != "" &&
    executableHash != "" &&
    targetTriple != "" &&
    targetOptionsHash != "" &&
    cacheKey != ""
  pub stable => valid
  pub debugName => "link.cache.key.{targetTriple}"
}
