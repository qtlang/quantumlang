
pub PipelineAdapter {
  plan: PipelinePlan
  materialize: Materialize
  result: PipelineResult
  writer: PipelineWriter
  diagnosticCode: string = ""
}

impl PipelineAdapter {
  pub PipelineAdapter(
    plan: PipelinePlan,
    materialize: Materialize,
    result: PipelineResult,
    writer: PipelineWriter
  ) =
    This {
      plan
      materialize
      result
      writer
    }

  pub fromPipeline(pipeline: Pipeline) -> This {
    return This {
      plan: pipeline.plan
      materialize: pipeline.materialize
      result: pipeline.result
      writer: PipelineWriter.pending(pipeline.plan, pipeline.result)
      diagnosticCode: match pipeline.valid {
        true => ""
        false => "QNATIVE0864"
      }
    }
  }
  pub writeStatus(io: CompilerIo) -> i64 {
    if valid == false {
      return -260
    }
    if materializationReady == false {
      return -261
    }
    if writer.diagnosticCode != "" || writer.outputPath == "" {
      return -231
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0901" {
      return -271
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0902" {
      return -272
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0903" {
      return -273
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0904" {
      return -274
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0905" {
      return -275
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0911" {
      return -281
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0912" {
      return -282
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0913" {
      return -283
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0914" {
      return -284
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0915" {
      return -285
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0916" {
      return -286
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0917" {
      return -287
    }
    if writer.objectPayload.diagnosticCode == "QNATIVE0784" {
      return -288
    }
    if writer.objectPayload.objectPath == "" {
      return -244
    }
    if writer.objectPayload.payloadHash == "" {
      return -245
    }
    if writer.objectPayload.byteCount <= 0 {
      return -249
    }
    if writer.objectPayload.diagnosticCode != "" {
      return -243
    }
    if writer.objectPayload.payloadReady == false {
      return -241
    }
    if io.atomicWriteBytes(
      writer.objectPayload.objectPath,
      writer.objectPayload.payload
    ) != 0 {
      return -242
    }
    if writer.runtimePayload.objectPath == "" {
      return -247
    }
    if writer.runtimePayload.payloadHash == "" {
      return -248
    }
    if writer.runtimePayload.byteCount <= 0 {
      return -249
    }
    if writer.runtimePayload.diagnosticCode != "" {
      return -246
    }
    if writer.runtimePayload.payloadReady == false {
      return -241
    }
    if io.atomicWriteBytes(
      writer.runtimePayload.objectPath,
      writer.runtimePayload.payload
    ) != 0 {
      return -242
    }
    if writer.executablePayload.valid == false {
      return -250
    }
    if writer.executablePayload.payloadReady == false {
      return -251
    }
    if writer.executablePayload.commandMaterialization {
      let linkStatus = io.run(writer.executablePayload.linkCommand.commandLine)
      if linkStatus != 0 {
        return -253
      }
      return 0
    }
    if io.atomicWriteBytes(
      writer.executablePayload.outputPath,
      writer.executablePayload.payload
    ) != 0 {
      return -252
    }
    return 0
  }

  pub write(io: CompilerIo) -> bool {
    return writeStatus(io) == 0
  }
}

impl view PipelineAdapter {
  pub valid: bool =>
    diagnosticCode == "" &&
    plan.valid &&
    materialize.valid &&
    result.valid

  pub materializationReady: bool =>
    valid &&
    materialize.ready &&
    result.runnable

  pub payloadReady: bool =>
    materializationReady &&
    writer.valid &&
    writer.payloadReady

  pub adapterHash: string =>
    "pipeline-adapter:{plan.planHash}:{materialize.materializeHash}:{result.resultHash}:{writer.writerHash}"

  pub materializerName: string => "qtlc1-native-pipeline"

  pub statusText: string => match true {
    payloadReady => "payload-ready"
    materializationReady => "pending-executable-payload"
    valid => "pending-materialization"
    _ => "invalid"
  }

  pub debugName: string => "pipeline.adapter.{statusText}"
}
