import query::{PhaseReport, SemanticDelta}

pub Pipeline {
  plan: PipelinePlan
  materialize: Materialize
  result: PipelineResult
  phaseReport: PhaseReport = {}
  semanticDelta: SemanticDelta = {}
  diagnosticCode: string = ""
}

impl Pipeline {
  pub Pipeline(
    plan: PipelinePlan,
    materialize: Materialize,
    result: PipelineResult,
    phaseReport: PhaseReport,
    semanticDelta: SemanticDelta
  ) =
    This {
      plan
      materialize
      result
      phaseReport
      semanticDelta
    }

  pub fromPlan(plan: PipelinePlan) =
    This {
      plan
      materialize: Materialize.fromPlan(plan)
      result: PipelineResult.fromMaterialize(Materialize.fromPlan(plan), plan.linkStage)
      phaseReport: PhaseReport.forTarget(plan.objectStage.packageRoot, 1)
      semanticDelta: SemanticDelta.backendBuild(
        match plan.objectCacheReplay.restoredObject {
          true => 1
          false => 0
        },
        match plan.objectCacheReplay.needsBuild {
          true => 1
          false => 0
        },
        plan.linkCacheReplay.needsLink,
        0,
        0,
        plan.objectCacheReplay.replayReason
      )
    }

  pub fromStages(objectStage: ObjectStage, linkStage: LinkStage) -> This {
    let io: CompilerIo = CompilerIo(objectStage.packageRoot)
    let phaseReport: PhaseReport = PhaseReport.forTarget(objectStage.packageRoot, 1)
    let objectLookupStart = io.monotonicNanoseconds()
    let objectBytes = ObjectBytes(
      objectStage.objectSetHash,
      objectStage.unitCount * 32,
      objectStage.unitCount * 24,
      0,
      objectStage.unitCount * 16,
      objectStage.unitCount * 72 + 64,
      "object-bytes:{objectStage.objectSetHash}:{objectStage.targetTriple}:{objectStage.unitCount}"
    )
    let objectKey = ObjectCacheKey.fromObjectBytes(
      objectStage.unitKeyAt(0),
      objectBytes,
      objectStage.objects.objectFormat
    )
    let objectEntry = ObjectCacheEntry.fromBytes(
      objectKey,
      objectStage.outputPath,
      objectBytes
    )
    let objectReplay = ObjectCacheReplay.miss(
      objectEntry,
      "qtlc1-native-object-materialization-required"
    )
    let objectLookupStop = io.monotonicNanoseconds()
    phaseReport.addElapsed(
      "backend.object",
      objectLookupStart,
      objectLookupStop,
      objectStage.unitCount,
      1,
      0,
      objectStage.unitCount,
      objectReplay.replayReason
    )
    let linkInputStart = io.monotonicNanoseconds()
    let target = TargetIdentity.resolveExpected(
      linkStage.targetTriple,
      linkStage.profile,
      objectStage.objects.objectFormat,
      objectStage.objects.abi
    )
    let executable = Executable.fromLinkResult(
      linkStage.result,
      target,
      objectBytes.byteCount + 4096
    )
    let linkKey = LinkCacheKey.fromLinker(linkStage.inputSet, executable)
    let linkEntry = LinkCacheEntry.fromExecutable(linkKey, executable)
    let linkReplay = LinkCacheReplay.miss(
      linkEntry,
      "qtlc1-native-link-materialization-required"
    )
    let linkInputStop = io.monotonicNanoseconds()
    phaseReport.addElapsed(
      "backend.link",
      linkInputStart,
      linkInputStop,
      linkStage.objectUnitCount,
      1,
      0,
      linkStage.objectUnitCount,
      linkReplay.replayReason
    )
    let plan = PipelinePlan.fromStages(objectStage, linkStage, objectReplay, linkReplay)
    let materialize = Materialize.fromPlan(plan)
    let result = PipelineResult.fromMaterialize(materialize, plan.linkStage)
    let semanticDelta = SemanticDelta.backendBuild(
      0,
      objectStage.unitCount,
      linkReplay.needsLink,
      objectLookupStop - objectLookupStart,
      linkInputStop - linkInputStart,
      "{objectReplay.replayReason}:{linkReplay.replayReason}"
    )
    return This(plan, materialize, result, phaseReport, semanticDelta)
  }
}

impl view Pipeline {
  pub valid: bool => diagnosticCode == "" &&
    plan.valid &&
    materialize.valid &&
    result.valid
  pub bridgeReady: bool => valid && materialize.ready && result.runnable
  pub pipelineHash: string => "pipeline:{plan.planHash}:{materialize.materializeHash}:{result.resultHash}"
  pub debugName: string => "native.pipeline.{bridgeReady}"
}
