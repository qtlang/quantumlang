import core::{Index, Map, ModuleId, NameId, ScopeId, SymbolId, Vec}

pub Scope {
  id: ScopeId = {}
  parent: ScopeId = {}
  module: ModuleId = {}
  depth: i64 = 0
  entries: Range<ScopeEntry> = []
  symbols: Range<SymbolId> = []
  localNames: Range<NameId> = []
  lookup: Map<NameId, SymbolId> = {}
  entryValues: Vec<ScopeEntry> = []
  symbolValues: Vec<SymbolId> = []
  nameValues: Vec<NameId> = []
  deterministic: bool = true
}

impl Scope {
  pub Scope(depth: i64) =
    This {
      id: ScopeId(1)
      depth
      entries: Range<ScopeEntry>()
      symbols: Range<SymbolId>()
      localNames: Range<NameId>()
      lookup: Map<NameId, SymbolId>.withCapacity(0)
    }

  pub Scope(id: ScopeId, parent: ScopeId, depth: i64, entryCount: i64) =
    This {
      id
      parent
      depth
      entries: Range(0, entryCount)
      symbols: Range(0, entryCount)
      localNames: Range(0, entryCount)
      lookup: Map<NameId, SymbolId>.withCapacity(entryCount)
    }

  pub forModule(id: ScopeId, module: ModuleId, entryCount: i64) =
    This {
      id
      module
      depth: 0
      entries: Range<ScopeEntry>(0, entryCount)
      symbols: Range<SymbolId>(0, entryCount)
      localNames: Range<NameId>(0, entryCount)
      lookup: Map<NameId, SymbolId>.withCapacity(entryCount)
    }

  pub add(entry: ScopeEntry) {
    entryValues.push(entry)
    symbolValues.push(entry.symbol)
    nameValues.push(entry.name)
    entries = Range(0, entryValues.count)
    symbols = Range(0, symbolValues.count)
    localNames = Range(0, nameValues.count)
    lookup = Map<NameId, SymbolId>.withCapacity(entryValues.count)
  }
}

impl view Scope {
  pub root: bool => depth == 0

  pub entryCount: i64 => entryValues.count

  pub symbolCount: i64 => symbolValues.count

  pub nameCount: i64 => nameValues.count

  pub hasParent: bool => parent.valid

  pub moduleScope: bool => module.valid

  pub entriesAligned: bool =>
    entryCount == symbolCount &&
    symbolCount == nameCount &&
    lookup.count == entryCount

  pub valid: bool =>
    deterministic &&
    id.valid &&
    depth >= 0 &&
    entries.valid &&
    symbols.valid &&
    localNames.valid &&
    lookup.valid &&
    entriesAligned
}
