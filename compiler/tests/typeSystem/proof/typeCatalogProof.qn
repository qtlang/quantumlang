import typeSystem::{*}
pub TypeCatalogProof {
  bytePrimitive: bool
  byteNotAlias: bool
  textViewsCore: bool
  bytesViewsCore: bool
  onlyIntUintAliases: bool
  dynamicTypesCore: bool
  dec32Core: bool
  coreFoundationCollections: bool
  oldNamesRejected: bool
  matrixSquareNormalized: bool
  operatorCatalog: bool
  deferredOperatorsCataloged: bool
  policyOperatorsCataloged: bool
  bitMethodsCataloged: bool
  primitiveIntegerLimits: bool
  primitiveRangeMembers: bool
  valid: bool
}

pub typeCatalogProof() -> TypeCatalogProof {
  let byteFact = primitiveTypeFact("byte")
  let bytePrimitive = byteFact.valid &&
    byteFact.family == PrimitiveTypeFamily.Byte &&
    byteFact.bitCount == 8 &&
    byteFact.sizeBytes == 1 &&
    byteFact.alignBytes == 1 &&
    byteFact.abiReturn == PrimitiveAbiReturnKind.Register

  let byteNotAlias = !isTypeCompatibilityAlias("byte") &&
    canonicalTypeAliasName("byte") == "byte"

  let textViewsCore = isCoreTypeName("string") &&
    isCoreTypeName("str") &&
    isTextBytesTypeName("str") &&
    !isTypeCompatibilityAlias("str")

  let bytesViewsCore = isCoreTypeName("bytes") &&
    isCoreTypeName("BytesView") &&
    isCoreTypeName("BytesMutView") &&
    !isTypeCompatibilityAlias("BytesView") &&
    !isTypeCompatibilityAlias("BytesMutView")

  let onlyIntUintAliases = typeAliasCount() == 4 &&
    isTypeCompatibilityAlias("int") &&
    isTypeCompatibilityAlias("uint") &&
    canonicalTypeAliasName("int") == "i64" &&
    canonicalTypeAliasName("uint") == "u64"

  let dynamicTypesCore = isBuiltinTypeName("any") &&
    isBuiltinTypeName("qany") &&
    coreTypeFamily("any") == CoreTypeFamily.Dynamic &&
    coreTypeFamily("qany") == CoreTypeFamily.Quantum &&
    coreTypeFamily("atomic<u64>") == CoreTypeFamily.Concurrency &&
    builtinTypeKind("any") == BuiltinTypeKind.Any &&
    builtinTypeKind("qany") == BuiltinTypeKind.QAny

  let dec32Core = isBuiltinTypeName("dec32") &&
    isDecimalFixedBigTypeName("dec32") &&
    coreTypeFamily("dec32") == CoreTypeFamily.Decimal &&
    builtinTypeKind("dec32") == BuiltinTypeKind.Decimal &&
    builtinNumericBitWidth("dec32") == 32

  let coreFoundationCollections = isCollectionFamilyTypeName("Range") &&
    isCollectionFamilyTypeName("Index") &&
    isCollectionFamilyTypeName("Arena") &&
    builtinTypeKind("Range") == BuiltinTypeKind.Range &&
    builtinTypeKind("Index") == BuiltinTypeKind.Index &&
    builtinTypeKind("Arena") == BuiltinTypeKind.Arena

  let oldNamesRejected = !isBuiltinTypeName("Unit") &&
    !isBuiltinTypeName("Bool") &&
    !isBuiltinTypeName("Text") &&
    !isBuiltinTypeName("String") &&
    !isBuiltinTypeName("Bytes") &&
    !isBuiltinTypeName("Vector3F64") &&
    !isBuiltinTypeName("Matrix3x3F64") &&
    !isBuiltinTypeName("Tensor2x2x2F64")

  let matrixSquareNormalized = canonicalTypeAliasName("matrix<2,2,f64>") == "matrix<2,f64>" &&
    canonicalTypeAliasName("matrix<3,3,f64>") == "matrix<3,f64>" &&
    !isTypeCompatibilityAlias("matrix<2,2,f64>") &&
    !isTypeCompatibilityAlias("matrix<3,3,f64>")

  let addOp = OperatorSyntaxFact.fromSymbol("+")
  let compareOp = OperatorSyntaxFact.fromSymbol("==")
  let assignOp = OperatorSyntaxFact.fromSymbol("+=")
  let indexOp = OperatorSyntaxFact.fromSymbol("[]")
  let propagateOp = OperatorSyntaxFact.fromSymbol("?")
  let operatorCatalog = addOp.arithmetic &&
    addOp.requiresTarget &&
    compareOp.comparison &&
    compareOp.resultTypeName == "bool" &&
    assignOp.assignment &&
    assignOp.mutates &&
    indexOp.index &&
    propagateOp.propagate

  let coalesceOp = OperatorSyntaxFact.fromSymbol("??")
  let safeAccessOp = OperatorSyntaxFact.fromSymbol("?.")
  let zeroFillShiftOp = OperatorSyntaxFact.fromSymbol(">>>")
  let compare3Op = OperatorSyntaxFact.fromSymbol("<=>")
  let pipelineOp = OperatorSyntaxFact.fromSymbol("|>")
  let receiveOp = OperatorSyntaxFact.fromSymbol("<-")
  let rangeOp = OperatorSyntaxFact.fromSymbol("..")
  let inclusiveRangeOp = OperatorSyntaxFact.fromSymbol("..=")
  let powerOp = OperatorSyntaxFact.fromSymbol("**")
  let bodyOp = OperatorSyntaxFact.fromSymbol("=>")
  let incrementOp = OperatorSyntaxFact.fromSymbol("++")
  let rejectedStrictEqual = OperatorSyntaxFact.fromSymbol("===")
  let referenceOp = OperatorSyntaxFact.fromForm("&", OperatorForm.Reference)
  let moveOp = OperatorSyntaxFact.fromForm("^", OperatorForm.Move)
  let dereferenceOp = OperatorSyntaxFact.fromForm("*", OperatorForm.Dereference)
  let optionalTypeOp = OperatorSyntaxFact.fromForm("?", OperatorForm.OptionalType)
  let spreadOp = OperatorSyntaxFact.fromForm("...", OperatorForm.Spread)
  let pathOp = OperatorSyntaxFact.fromForm("::", OperatorForm.Path)
  let deferredOperatorsCataloged = coalesceOp.coalesce &&
    safeAccessOp.safeAccess &&
    zeroFillShiftOp.shift &&
    compare3Op.compare &&
    pipelineOp.pipeline &&
    receiveOp.communication &&
    rangeOp.range &&
    inclusiveRangeOp.range &&
    powerOp.arithmetic &&
    bodyOp.syntaxBody &&
    incrementOp.increment &&
    referenceOp.address &&
    moveOp.move &&
    dereferenceOp.dereference &&
    optionalTypeOp.optionalType &&
    spreadOp.spread &&
    pathOp.path &&
    !rejectedStrictEqual.valid

  let ringOp = OperatorTable.resolve("RingU64", "u64", "*", "binary")
  let satOp = OperatorTable.resolve("SatI64", "i64", "+", "binary")
  let overflowOp = OperatorTable.resolve("OverflowU64", "u64", "*", "binary")
  let atomicOp = OperatorTable.resolve("Atomic<u64>", "u64", "+=", "assignment")
  let atomicGenericAdd = OperatorTable.resolve("Atomic<u64>", "u64", "+=", "assignment")
  let atomicGenericInc = OperatorTable.resolve("Atomic<i64>", "", "++", "unary")
  let atomicGenericStore = OperatorTable.resolve("Atomic<bool>", "bool", "=", "assignment")
  let atomicGenericShift = OperatorTable.resolve("Atomic<u64>", "u64", ">>>=", "assignment")
  let atomicCompareRejected = OperatorTable.resolve("Atomic<i64>", "i64", "==", "binary")
  let atomicLogicalRejected = OperatorTable.resolve("Atomic<bool>", "bool", "&&", "binary")
  let atomicOwnerRhs = OperatorTable.resolve("Atomic<i64>", "Atomic<i64>", "+=", "assignment")
  let atomicBoolAddRejected = OperatorTable.resolve("Atomic<bool>", "bool", "+=", "assignment")
  let atomicConstPointerStore = OperatorTable.resolve(
    "Atomic<const *Node>",
    "const *Node",
    "=",
    "assignment"
  )
  let volatileOp = OperatorTable.resolve("VolatileU32", "u32", "|", "binary")
  let checkedOp = OperatorTable.resolve("u64", "u64", "*", "binary")
  let logicalShiftOp = OperatorTable.resolve("u64", "u64", ">>>", "binary")
  let logicalShiftAssignOp = OperatorTable.resolve("u64", "u64", ">>>=", "assignment")
  let policyOperatorsCataloged = ringOp.policyKind == Wrapping &&
    ringOp.resultTypeName == "u64" &&
    satOp.policyKind == Saturating &&
    satOp.resultTypeName == "i64" &&
    overflowOp.policyKind == Overflowing &&
    overflowOp.resultTypeName == "OverflowResult<u64>" &&
    atomicOp.policyKind == Atomic &&
    atomicGenericAdd.policyKind == Atomic &&
    atomicGenericInc.policyKind == Atomic &&
    atomicGenericStore.policyKind == Atomic &&
    atomicGenericShift.policyKind == Atomic &&
    !atomicCompareRejected.valid &&
    !atomicLogicalRejected.valid &&
    atomicOwnerRhs.policyKind == Atomic &&
    !atomicBoolAddRejected.valid &&
    atomicConstPointerStore.policyKind == Atomic &&
    atomicConstPointerStore.mutates &&
    volatileOp.policyKind == Volatile &&
    checkedOp.policyKind == Checked &&
    logicalShiftOp.resultTypeName == "u64" &&
    logicalShiftAssignOp.mutates

  let rotl = OperatorBitMethodFact.fromName("u64", "rotl")
  let popcnt = OperatorBitMethodFact.fromName("u64", "popcnt")
  let setBit = OperatorBitMethodFact.fromName("u64", "setBit")
  let bitMethodsCataloged = rotl.valid &&
    rotl.resultTypeName == "u64" &&
    popcnt.valid &&
    popcnt.resultTypeName == "u32" &&
    setBit.valid &&
    setBit.mutates

  let i64Int = PrimitiveIntFact.fromTypeName("i64")
  let usizeInt = PrimitiveIntFact.fromTypeName("usize")
  let u256Int = PrimitiveIntFact.fromTypeName("u256")
  let primitiveIntegerLimits = i64Int.rangeIndexReady &&
    i64Int.bits == 64 &&
    i64Int.signed &&
    i64Int.maxLiteral == "9223372036854775807" &&
    usizeInt.rangeIndexReady &&
    !usizeInt.signed &&
    usizeInt.bits == 64 &&
    u256Int.rangeIndexReady &&
    u256Int.bits == 256 &&
    !u256Int.signed

  let i64Max = PrimitiveMemberFact.fromReceiver("i64", "max")
  let i64Signed = PrimitiveMemberFact.fromReceiver("i64", "signed")
  let usizeZero = PrimitiveMemberFact.fromReceiver("usize", "zero")
  let u256Max = PrimitiveMemberFact.fromReceiver("u256", "max")
  let primitiveRangeMembers = i64Max.valid &&
    i64Max.returnTypeName == "i64" &&
    i64Max.literalText == i64Int.maxLiteral &&
    i64Signed.valid &&
    i64Signed.returnTypeName == "bool" &&
    i64Signed.literalText == "true" &&
    usizeZero.valid &&
    usizeZero.returnTypeName == "usize" &&
    usizeZero.literalText == "0" &&
    u256Max.valid &&
    u256Max.returnTypeName == "u256" &&
    u256Max.literalText == u256Int.maxLiteral

  let valid = bytePrimitive &&
    byteNotAlias &&
    textViewsCore &&
    bytesViewsCore &&
    onlyIntUintAliases &&
    dynamicTypesCore &&
    dec32Core &&
    coreFoundationCollections &&
    oldNamesRejected &&
    matrixSquareNormalized &&
    operatorCatalog &&
    deferredOperatorsCataloged &&
    policyOperatorsCataloged &&
    bitMethodsCataloged &&
    primitiveIntegerLimits &&
    primitiveRangeMembers

  return TypeCatalogProof {
    bytePrimitive: bytePrimitive,
    byteNotAlias: byteNotAlias,
    textViewsCore: textViewsCore,
    bytesViewsCore: bytesViewsCore,
    onlyIntUintAliases: onlyIntUintAliases,
    dynamicTypesCore: dynamicTypesCore,
    dec32Core: dec32Core,
    coreFoundationCollections: coreFoundationCollections,
    oldNamesRejected: oldNamesRejected,
    matrixSquareNormalized: matrixSquareNormalized,
    operatorCatalog: operatorCatalog,
    deferredOperatorsCataloged: deferredOperatorsCataloged,
    policyOperatorsCataloged: policyOperatorsCataloged,
    bitMethodsCataloged: bitMethodsCataloged,
    primitiveIntegerLimits: primitiveIntegerLimits,
    primitiveRangeMembers: primitiveRangeMembers,
    valid: valid,
  }
}
