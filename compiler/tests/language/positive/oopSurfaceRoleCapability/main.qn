role Capability {
  capabilityName() -> string
}

role PackRole<T, ...Caps> {
  packValue() -> i64
}

role MainSurfaceRole {
  mainSurfaceValue() -> i64
}

role ViewSurfaceRole {
  viewSurfaceValue() -> i64
}

role ContextSurfaceRole {
  contextSurfaceValue() -> i64
}

role ExtractSurfaceRole {
  extractSurfaceValue() -> i64
}

role ExtendSurfaceRole {
  extendedSurfaceValue() -> i64
}

AuthUser {
  id: i64 = 0
}

CsrfToken {
  value: string = ""
}

Session<T> {
  value: T
}

HttpCtx<T, ...Caps> {
  value: i64 = 0
}

SurfaceCounter {
  value: i64 = 0
}

extend AuthUser : pub Capability {
  pub capabilityName() -> string {
    return "auth-user"
  }
}

extend<T> Session<T> : pub Capability {
  pub capabilityName() -> string {
    return "session"
  }
}

extend CsrfToken : pub Capability {
  pub capabilityName() -> string {
    return "csrf-token"
  }
}

impl<T, ...Caps> HttpCtx<T, ...Caps> :
  pub PackRole<T, ...Caps>
where
  T: Capability,
  ...Caps: Capability
{
  pub packValue() -> i64 {
    return this.value
  }
}

impl SurfaceCounter : pub MainSurfaceRole {
  pub mainBase() -> i64 {
    return this.value
  }

  pub mainImplicitPeer() -> i64 {
    return mainBase()
  }

  pub mainExplicitPeer() -> i64 {
    return this.mainBase()
  }

  pub mainSurfaceValue() -> i64 {
    return mainImplicitPeer()
  }
}

impl view SurfaceCounter : pub ViewSurfaceRole {
  pub viewBase() -> i64 {
    return this.value + 1
  }

  pub viewImplicitPeer() -> i64 {
    return viewBase()
  }

  pub viewExplicitPeer() -> i64 {
    return this.viewBase()
  }

  pub viewSurfaceValue() -> i64 {
    return viewImplicitPeer()
  }
}

context SurfaceCounter : pub ContextSurfaceRole {
  pub contextBase() -> i64 {
    return value + 2
  }

  pub contextImplicitPeer() -> i64 {
    return contextBase()
  }

  pub contextExplicitPeer() -> i64 {
    return this.contextBase()
  }

  pub contextSurfaceValue() -> i64 {
    return contextImplicitPeer()
  }
}

extract SurfaceCounter : pub ExtractSurfaceRole {
  pub extractBase() -> i64 {
    return value + 3
  }

  pub extractImplicitPeer() -> i64 {
    return extractBase()
  }

  pub extractExplicitPeer() -> i64 {
    return this.extractBase()
  }

  pub extractSurfaceValue() -> i64 {
    return extractImplicitPeer()
  }
}

extend SurfaceCounter : pub ExtendSurfaceRole {
  pub extendBase() -> i64 {
    return this.value + 4
  }

  pub extendImplicitPeer() -> i64 {
    return extendBase()
  }

  pub extendExplicitPeer() -> i64 {
    return this.extendBase()
  }

  pub extendedSurfaceValue() -> i64 {
    return extendImplicitPeer()
  }
}

surfaceRoleProof() -> bool {
  const counter: SurfaceCounter = { value: 10 }
  return counter.mainSurfaceValue() == 10 &&
    counter.mainImplicitPeer() == 10 &&
    counter.mainExplicitPeer() == 10 &&
    counter.viewSurfaceValue() == 11 &&
    counter.viewImplicitPeer() == 11 &&
    counter.viewExplicitPeer() == 11 &&
    counter.contextSurfaceValue() == 12 &&
    counter.contextImplicitPeer() == 12 &&
    counter.contextExplicitPeer() == 12 &&
    counter.extractSurfaceValue() == 13 &&
    counter.extractImplicitPeer() == 13 &&
    counter.extractExplicitPeer() == 13 &&
    counter.extendedSurfaceValue() == 14 &&
    counter.extendImplicitPeer() == 14 &&
    counter.extendExplicitPeer() == 14
}

main() -> i64 {
  const ctx: HttpCtx<AuthUser, Session<AuthUser>, CsrfToken> = { value: 7 }
  if ctx.packValue() != 7 {
    return 1
  }
  if !surfaceRoleProof() {
    return 2
  }
  return 0
}
