pub ByteWriteView {
  value: BytesMutView
  offset: usize = 0
  length: usize = 0
}

impl ByteWriteView {
  pub ByteWriteView(value: BytesMutView) -> This {
    let byteCount: usize = value.length
    return This { value, length: byteCount }
  }

  pub ByteWriteView(value: BytesMutView, offset: usize, length: usize) =
    This { value, offset, length }

  pub slice(start: usize, count: usize) -> Result<ByteWriteView, ByteError> {
    if start > length || count > length - start {
      return Err(ByteError(
        ByteErrorKind.OutOfBounds,
        offset + start,
        count,
        length
      ))
    }

    return Ok(This(value, offset + start, count))
  }

}

impl view ByteWriteView {
  pub end => offset + length
  pub empty => length == 0
  pub valid => end <= value.length
}
