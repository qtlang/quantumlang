pub AsciiByte {
  value: i64
}

impl AsciiByte {
  pub AsciiByte(value: i64) =
    This { value }
}

impl view AsciiByte {
  pub valid: bool => value >= 0 && value <= 127

  pub isAscii: bool => value >= 0 && value <= 127

  pub isControl: bool => (value >= 0 && value <= 31) || value == 127

  pub isPrintable: bool => value >= 32 && value <= 126

  pub isWhitespace: bool => value == 32 || value == 9 || value == 10 || value == 13

  pub isHorizontalWhitespace: bool => value == 32 || value == 9

  pub isLineBreak: bool => value == 10 || value == 13

  pub isDigit: bool => value >= 48 && value <= 57

  pub isHexDigit: bool => {
    this.isDigit ||
      (value >= 65 && value <= 70) ||
      (value >= 97 && value <= 102)
  }

  pub isBinaryDigit: bool => value == 48 || value == 49

  pub isOctalDigit: bool => value >= 48 && value <= 55

  pub isUpper: bool => value >= 65 && value <= 90

  pub isLower: bool => value >= 97 && value <= 122

  pub isAsciiUpper: bool => this.isUpper

  pub isAsciiLower: bool => this.isLower

  pub isAsciiAlpha: bool => this.isAlpha

  pub startsUpper: bool => this.startsAsciiUpper

  pub startsLower: bool => this.startsAsciiLower

  pub startsAlpha: bool => this.startsAsciiAlpha

  pub startsAsciiUpper: bool => this.isUpper

  pub startsAsciiLower: bool => this.isLower

  pub startsAsciiAlpha: bool => this.isAlpha

  pub isAlpha: bool => this.isUpper || this.isLower

  pub isAlphaNumeric: bool => this.isAlpha || this.isDigit

  pub isUnderscore: bool => value == 95

  pub isIdentifierStart: bool => this.isUnderscore || this.isAlpha

  pub isIdentifierContinue: bool => this.isIdentifierStart || this.isDigit

  pub isDelimiter: bool => {
    value == 40 ||
      value == 41 ||
      value == 91 ||
      value == 93 ||
      value == 123 ||
      value == 125 ||
      value == 44 ||
      value == 59
  }

  pub isQuote: bool => value == 34 || value == 39 || value == 96

  pub isOperatorStart: bool => {
    value == 33 ||
      value == 37 ||
      value == 38 ||
      value == 42 ||
      value == 43 ||
      value == 45 ||
      value == 46 ||
      value == 47 ||
      value == 58 ||
      value == 60 ||
      value == 61 ||
      value == 62 ||
      value == 63 ||
      value == 94 ||
      value == 124 ||
      value == 126
  }

  pub digitValue: i64 => {
    if this.isDigit {
      return value - 48
    }
    return -1
  }

  pub hexValue: i64 => {
    if this.isDigit {
      return value - 48
    }
    if value >= 65 && value <= 70 {
      return value - 55
    }
    if value >= 97 && value <= 102 {
      return value - 87
    }
    return -1
  }
}
