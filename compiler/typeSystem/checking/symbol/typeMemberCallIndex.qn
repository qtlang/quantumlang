import core::{Arena, CompilerId, DeclarationId, Index, ModuleId, SymbolId, TypeId, Vec}
import declaration::{DeclarationKey, DeclarationRecord}
import diagnostics::{DiagnosticRegistry, DiagnosticSpec, TypeDiagnosticCode}
import frontend::{FrontendProduct}
import source::{SourceSpan}

extend TypeSymbolTable {
  indexMemberCallable(
    symbol: TypeSymbol,
    rowIndex: usize,
    moduleSymbolKey: string,
    memberOwnerKey: string
  ) {
    let memberCallKey = TypeSymbolLookupKey.memberCall(
      symbol.name,
      symbol.memberCallArgumentCount,
      symbol.genericParameterCount
    )
    let memberCallEntry = memberCallRows.count as usize
    let previousMemberCall = memberCallLatestLookup.rowFor(
      symbol.ownerTypeName,
      memberCallKey
    )
    let previousMemberCallable = memberCallableLatestLookup.rowFor(
      symbol.ownerTypeName,
      symbol.name
    )

    memberCallOwnerNames.push(symbol.ownerTypeName)
    memberCallNames.push(symbol.name)
    memberCallParameterCounts.push(symbol.memberCallArgumentCount)
    memberCallGenericCounts.push(symbol.genericParameterCount)
    memberCallRows.push(rowIndex)
    memberCallPreviousRows.push(previousMemberCall)
    memberCallablePreviousRows.push(previousMemberCallable)
    memberCallLatestLookup.put(
      symbol.ownerTypeName,
      memberCallKey,
      memberCallEntry
    )
    memberCallableLatestLookup.put(
      symbol.ownerTypeName,
      symbol.name,
      memberCallEntry
    )

    memberSignatureLookup.add(
      memberOwnerKey,
      this.memberSignatureKey(symbol),
      rowIndex
    )
    memberLookup.add(memberOwnerKey, memberCallKey, rowIndex)
    memberLookup.add(symbol.ownerTypeName, memberCallKey, rowIndex)
    this.indexStaticFactory(
      symbol,
      rowIndex,
      memberOwnerKey,
      memberCallKey
    )

    if !memberCallableLookup.add(memberOwnerKey, symbol.name, rowIndex) {
      memberCallableAmbiguousLookup.add(memberOwnerKey, symbol.name, rowIndex)
    }
    if !memberCallableLookup.add(symbol.ownerTypeName, symbol.name, rowIndex) {
      memberCallableAmbiguousLookup.add(symbol.ownerTypeName, symbol.name, rowIndex)
    }

    if symbol.returnTypeName != "" && symbol.returnTypeName != "void" {
      if !callableResultLookup.add(
        symbol.returnTypeName,
        symbol.name,
        rowIndex
      ) {
        callableResultAmbiguousLookup.add(
          symbol.returnTypeName,
          symbol.name,
          rowIndex
        )
      }
      this.recordResultCall(symbol.returnTypeName, symbol, rowIndex)
    }
    if symbol.returnTypeName == "This" && symbol.ownerTypeName != "" {
      if !callableResultLookup.add(
        symbol.ownerTypeName,
        symbol.name,
        rowIndex
      ) {
        callableResultAmbiguousLookup.add(
          symbol.ownerTypeName,
          symbol.name,
          rowIndex
        )
      }
      this.recordResultCall(symbol.ownerTypeName, symbol, rowIndex)
    }

    if !moduleMemberCallLookup.add(
      moduleSymbolKey,
      memberCallKey,
      rowIndex
    ) {
      moduleMemberCallAmbiguousLookup.add(
        moduleSymbolKey,
        memberCallKey,
        rowIndex
      )
    }
    if !moduleMemberCallableLookup.add(
      moduleSymbolKey,
      symbol.name,
      rowIndex
    ) {
      moduleMemberCallableAmbiguousLookup.add(
        moduleSymbolKey,
        symbol.name,
        rowIndex
      )
    }

    if symbol.genericParameterCount > 0 {
      let inferredKey = TypeSymbolLookupKey.memberCall(
        symbol.name,
          symbol.memberCallArgumentCount,
        0
      )
      inferredMemberLookup.add(memberOwnerKey, inferredKey, rowIndex)
      inferredMemberLookup.add(symbol.ownerTypeName, inferredKey, rowIndex)
      if !moduleMemberCallLookup.add(
        moduleSymbolKey,
        inferredKey,
        rowIndex
      ) {
        moduleMemberCallAmbiguousLookup.add(
          moduleSymbolKey,
          inferredKey,
          rowIndex
        )
      }
      this.indexStaticFactory(
        symbol,
        rowIndex,
        memberOwnerKey,
        inferredKey
      )
    }

  }

  memberValueMatches(
    symbol: TypeSymbol,
    ownerTypeName: string,
    name: string
  ) -> bool {
    return symbol.name == name &&
      (symbol.memberValue || symbol.memberKind == "property") &&
      this.sourceReceiverLookupTypeName(symbol.ownerTypeName) == ownerTypeName
  }

  memberCallableMatches(
    symbol: TypeSymbol,
    ownerTypeName: string,
    name: string,
    argumentCount: i64,
    genericArgumentCount: i64
  ) -> bool {
    return symbol.name == name &&
      this.indexableMemberCallable(symbol) &&
      symbol.memberCallArgumentCount == argumentCount &&
      symbol.genericParameterCount == genericArgumentCount &&
      this.sourceReceiverLookupTypeName(symbol.ownerTypeName) == ownerTypeName
  }

  memberCallableNamedMatches(
    symbol: TypeSymbol,
    ownerTypeName: string,
    name: string
  ) -> bool {
    return symbol.name == name &&
      this.indexableMemberCallable(symbol) &&
      this.sourceReceiverLookupTypeName(symbol.ownerTypeName) == ownerTypeName
  }

  indexableMemberCallable(symbol: TypeSymbol) -> bool {
    return symbol.name != "" &&
      symbol.ownerTypeName != "" &&
      symbol.memberCallArgumentCount >= 0 &&
      (symbol.memberCallable || symbol.memberKind == "method")
  }

  pub symbolValueForMemberCall(
    moduleId: ModuleId,
    ownerTypeName: string,
    name: string,
    argumentCount: i64,
    genericArgumentCount: i64
  ) -> TypeSymbol {
    let lookupOwnerTypeName = this.sourceReceiverLookupTypeName(ownerTypeName)
    let staticFactory = this.symbolValueForStaticFactoryCall(
      moduleId,
      lookupOwnerTypeName,
      name,
      argumentCount,
      genericArgumentCount
    )
    if staticFactory.id.valid {
      return staticFactory
    }
    let directMember = this.symbolValueForMemberCallRow(
      lookupOwnerTypeName,
      name,
      argumentCount,
      genericArgumentCount
    )
    if directMember.id.valid {
      return directMember
    }
    let exactRow = this.memberCallRowFor(
      lookupOwnerTypeName,
      name,
      argumentCount,
      genericArgumentCount
    )
    match exactRow {
      Some(row) => {
        let symbol: TypeSymbol = symbolValues[row]
        if this.memberCallableMatches(
          symbol,
          lookupOwnerTypeName,
          name,
          argumentCount,
          genericArgumentCount
        ) {
          return symbol
        }
        let baseOwnerTypeName = TypeSymbolLookupKey.genericBaseName(lookupOwnerTypeName)
        if baseOwnerTypeName != lookupOwnerTypeName &&
           this.memberCallableMatches(
             symbol,
             baseOwnerTypeName,
             name,
             argumentCount,
             genericArgumentCount
           ) {
          return symbol.specializedFor(lookupOwnerTypeName)
        }
      }
      None => {}
    }
    let ownerKey = TypeSymbolLookupKey.memberOwner(moduleId, lookupOwnerTypeName)
    let key = TypeSymbolLookupKey.memberCall(name, argumentCount, genericArgumentCount)
    match memberLookup.rowFor(ownerKey, key) {
      Some(row) => {
        let symbol: TypeSymbol = symbolValues[row]
        if this.memberCallableMatches(
          symbol,
          lookupOwnerTypeName,
          name,
          argumentCount,
          genericArgumentCount
        ) {
          return symbol
        }
      }
      None => {}
    }
    let baseOwnerTypeName = TypeSymbolLookupKey.genericBaseName(lookupOwnerTypeName)
    if baseOwnerTypeName != lookupOwnerTypeName {
      match memberLookup.rowFor(
        TypeSymbolLookupKey.memberOwner(moduleId, baseOwnerTypeName),
        key
      ) {
        Some(row) => {
          let symbol: TypeSymbol = symbolValues[row]
          if this.memberCallableMatches(
            symbol,
            baseOwnerTypeName,
            name,
            argumentCount,
            genericArgumentCount
          ) {
            return symbol.specializedFor(lookupOwnerTypeName)
          }
        }
        None => {}
      }
    }
    if genericArgumentCount == 0 {
      match inferredMemberLookup.rowFor(ownerKey, key) {
        Some(row) => {
          let symbol: TypeSymbol = symbolValues[row]
          if symbol.name == name &&
             this.indexableMemberCallable(symbol) &&
             symbol.memberCallArgumentCount == argumentCount &&
             symbol.genericParameterCount > 0 &&
             this.sourceReceiverLookupTypeName(symbol.ownerTypeName) ==
               lookupOwnerTypeName {
            return symbol
          }
        }
        None => {}
      }
      if baseOwnerTypeName != lookupOwnerTypeName {
        match inferredMemberLookup.rowFor(
          TypeSymbolLookupKey.memberOwner(moduleId, baseOwnerTypeName),
          key
        ) {
          Some(row) => {
            let symbol: TypeSymbol = symbolValues[row]
            if symbol.name == name &&
               this.indexableMemberCallable(symbol) &&
               symbol.memberCallArgumentCount == argumentCount &&
               symbol.genericParameterCount > 0 &&
               this.sourceReceiverLookupTypeName(symbol.ownerTypeName) ==
                 baseOwnerTypeName {
              return symbol.specializedFor(lookupOwnerTypeName)
            }
          }
          None => {}
        }
      }
    }
    let factory = this.symbolValueForResultFactoryCall(
      lookupOwnerTypeName,
      name,
      argumentCount,
      genericArgumentCount
    )
    if factory.id.valid {
      return factory
    }
    return TypeSymbol()
  }

