pub OperatorTable {
}

impl OperatorTable {
  pub resolve(ownerTypeName: string, rightTypeName: string, symbol: string, form: string) -> OperatorResolutionRow {
    let surface = This.surface(ownerTypeName, rightTypeName, symbol, form)
    let candidate = This.candidate(surface)
    let policy = OperatorPolicyRow.fromCandidate(candidate, This.policyFor(surface))
    let lowering = OperatorLoweringRow.fromPolicy(policy)
    return OperatorResolutionRow {
      surface
      candidate
      policy
      lowering
      diagnosticCode: match lowering.valid {
        true => ""
        false => "operator-lowering-unavailable"
      }
      valid: lowering.valid
    }
  }

  pub surface(ownerTypeName: string, rightTypeName: string, symbol: string, form: string) -> OperatorSurfaceRow {
    let builtin = OperatorSyntaxFact.fromSymbol(symbol)
    if !builtin.valid {
      return OperatorSurfaceRow { ownerTypeName, rightTypeName, symbol, form }
    }
    if form == "binary" {
      return This.binarySurface(ownerTypeName, rightTypeName, symbol, builtin)
    }
    if form == "unary" {
      return This.unarySurface(ownerTypeName, symbol, builtin)
    }
    if form == "assignment" {
      return This.assignmentSurface(ownerTypeName, rightTypeName, symbol, builtin)
    }
    if form == "index" || form == "call" || form == "member" ||
       form == "cast" || form == "propagate" {
      return OperatorSurfaceRow {
        ownerTypeName
        rightTypeName
        symbol
        form
        resultTypeName: match builtin.hasFixedResult {
          true => builtin.resultTypeName
          false => ownerTypeName
        }
        mutates: builtin.mutates
        requiresTarget: builtin.requiresTarget
        valid: ownerTypeName != "" || builtin.hasFixedResult
      }
    }
    return OperatorSurfaceRow { ownerTypeName, rightTypeName, symbol, form }
  }

  pub binarySurface(
    ownerTypeName: string,
    rightTypeName: string,
    symbol: string,
    builtin: OperatorSyntaxFact
  ) -> OperatorSurfaceRow {
    if This.policyForType(ownerTypeName) == Atomic {
      return OperatorSurfaceRow { ownerTypeName, rightTypeName, symbol, form: "binary" }
    }
    if builtin.compare {
      return OperatorSurfaceRow {
        ownerTypeName
        rightTypeName
        symbol
        form: "binary"
        resultTypeName: "CompareResult"
        valid: true
      }
    }
    if builtin.comparison || builtin.logical {
      return OperatorSurfaceRow {
        ownerTypeName
        rightTypeName
        symbol
        form: "binary"
        resultTypeName: "bool"
        valid: true
      }
    }
    if This.primitiveNumeric(ownerTypeName) &&
       (rightTypeName == "" || This.primitiveNumeric(rightTypeName)) &&
       (builtin.arithmetic || builtin.bitwise || builtin.shift) {
      return OperatorSurfaceRow {
        ownerTypeName
        rightTypeName: match rightTypeName == "" {
          true => ownerTypeName
          false => rightTypeName
        }
        symbol
        form: "binary"
        resultTypeName: ownerTypeName
        requiresTarget: true
        valid: true
      }
    }
    if This.policyNumeric(ownerTypeName) &&
       (rightTypeName == "" || This.compatiblePolicyRight(ownerTypeName, rightTypeName)) &&
       (builtin.arithmetic || builtin.bitwise || builtin.shift) &&
       This.policyOperatorAllowed(ownerTypeName, symbol, "binary") {
      return OperatorSurfaceRow {
        ownerTypeName
        rightTypeName: match rightTypeName == "" {
          true => ownerTypeName
          false => rightTypeName
        }
        symbol
        form: "binary"
        resultTypeName: This.policyResultType(ownerTypeName)
        policyTypeName: ownerTypeName
        requiresTarget: true
        valid: true
      }
    }
    if builtin.safeAccess || builtin.coalesce || builtin.pipeline ||
       builtin.communication {
      return OperatorSurfaceRow {
        ownerTypeName
        rightTypeName
        symbol
        form: "binary"
        resultTypeName: ownerTypeName
        requiresTarget: true
        valid: ownerTypeName != ""
      }
    }
    return OperatorSurfaceRow { ownerTypeName, rightTypeName, symbol, form: "binary" }
  }

  pub unarySurface(ownerTypeName: string, symbol: string, builtin: OperatorSyntaxFact) -> OperatorSurfaceRow {
    if builtin.logical {
      return OperatorSurfaceRow { ownerTypeName, symbol, form: "unary", resultTypeName: "bool", valid: true }
    }
    if This.primitiveNumeric(ownerTypeName) &&
       (builtin.arithmetic || builtin.bitwise || builtin.address || builtin.dereference) {
      return OperatorSurfaceRow {
        ownerTypeName
        symbol
        form: "unary"
        resultTypeName: ownerTypeName
        requiresTarget: true
        valid: true
      }
    }
    if This.policyNumeric(ownerTypeName) &&
       (builtin.arithmetic || builtin.bitwise || builtin.increment) &&
       This.policyOperatorAllowed(ownerTypeName, symbol, "unary") {
      return OperatorSurfaceRow {
        ownerTypeName
        symbol
        form: "unary"
        resultTypeName: This.policyResultType(ownerTypeName)
        policyTypeName: ownerTypeName
        mutates: builtin.increment
        requiresTarget: true
        valid: true
      }
    }
    return OperatorSurfaceRow { ownerTypeName, symbol, form: "unary" }
  }

  pub assignmentSurface(
    ownerTypeName: string,
    rightTypeName: string,
    symbol: string,
    builtin: OperatorSyntaxFact
  ) -> OperatorSurfaceRow {
    if This.policyForType(ownerTypeName) == Atomic &&
       !This.policyOperatorAllowed(ownerTypeName, symbol, "assignment") {
      return OperatorSurfaceRow { ownerTypeName, rightTypeName, symbol, form: "assignment" }
    }
    if builtin.assignment && ownerTypeName != "" {
      return OperatorSurfaceRow {
        ownerTypeName
        rightTypeName: match rightTypeName == "" {
          true => ownerTypeName
          false => rightTypeName
        }
        symbol
        form: "assignment"
        resultTypeName: "void"
        policyTypeName: match This.policyNumeric(ownerTypeName) {
          true => ownerTypeName
          false => ""
        }
        assignmentBase: builtin.assignmentBase
        mutates: true
        requiresTarget: true
        valid: true
      }
    }
    return OperatorSurfaceRow { ownerTypeName, rightTypeName, symbol, form: "assignment" }
  }

  pub candidate(surface: OperatorSurfaceRow) -> OperatorCandidateRow {
    return OperatorCandidateRow {
      surface
      builtin: true
      primitive: This.primitiveNumeric(surface.ownerTypeName) ||
        surface.ownerTypeName == "bool"
      policyPrimitive: This.policyNumeric(surface.ownerTypeName)
      userDefined: false
      score: match surface.valid {
        true => 100
        false => -1
      }
      valid: surface.valid
    }
  }

  pub policyFor(surface: OperatorSurfaceRow) -> OperatorPolicyKind {
    if !surface.valid {
      return Unknown
    }
    if surface.form == "binary" || surface.form == "assignment" ||
       surface.form == "unary" {
      if surface.policyTypeName != "" {
        return This.policyForType(surface.policyTypeName)
      }
      if surface.symbol == "??" || surface.symbol == "?." {
        return Exact
      }
      if surface.symbol == "|>" || surface.symbol == "<-" {
        return Exact
      }
      return Checked
    }
    return Exact
  }

  pub primitiveNumeric(name: string) -> bool {
    return isPrimitiveIntegerTypeName(name) || isPrimitiveFloatTypeName(name)
  }

  pub compatiblePolicyRight(ownerTypeName: string, rightTypeName: string) -> bool {
    if rightTypeName == ownerTypeName {
      return true
    }
    let payload = This.policyPayloadType(ownerTypeName)
    if This.policyForType(ownerTypeName) == Atomic &&
       This.policyForType(rightTypeName) == Atomic {
      return payload != "" && payload == This.policyPayloadType(rightTypeName)
    }
    return payload != "" &&
      (rightTypeName == payload || This.primitiveNumeric(rightTypeName))
  }

  pub policyOperatorAllowed(ownerTypeName: string, symbol: string, form: string) -> bool {
    if This.policyForType(ownerTypeName) != Atomic {
      return true
    }
    let payload = This.policyPayloadType(ownerTypeName)
    if payload == "" {
      return false
    }
    if form == "binary" {
      return false
    }
    if form == "unary" {
      return This.atomicIntegerPayload(payload) &&
        (symbol == "++" || symbol == "--")
    }
    if form == "assignment" {
      if symbol == "=" {
        return true
      }
      if This.atomicIntegerPayload(payload) {
        return symbol == "+=" || symbol == "-=" ||
          symbol == "&=" || symbol == "|=" || symbol == "^=" ||
          symbol == "<<=" || symbol == ">>=" || symbol == ">>>="
      }
      return false
    }
    return false
  }

  pub atomicIntegerPayload(payload: string) -> bool {
    return isPrimitiveIntegerTypeName(payload) ||
      payload == "isize" || payload == "usize"
  }

  pub policyNumeric(name: string) -> bool {
    return This.policyPayloadType(name) != ""
  }

  pub policyResultType(name: string) -> string {
    if This.policyForType(name) == Overflowing {
      return "OverflowResult<" + This.policyPayloadType(name) + ">"
    }
    return This.policyPayloadType(name)
  }

  pub policyForType(name: string) -> OperatorPolicyKind {
    if This.startsWith(name, "Ring") {
      return Wrapping
    }
    if This.startsWith(name, "Sat") {
      return Saturating
    }
    if This.startsWith(name, "Overflow") {
      return Overflowing
    }
    if This.startsWith(name, "Wide") {
      return Widening
    }
    if This.startsWith(name, "Exact") {
      return Exact
    }
    if This.startsWith(name, "Atomic") {
      return Atomic
    }
    if This.startsWith(name, "Volatile") {
      return Volatile
    }
    if This.startsWith(name, "Raw") {
      return UnsafeRaw
    }
    return Unknown
  }

  pub policyPayloadType(name: string) -> string {
    let payload = This.policyPayloadAfter(name, "Overflow")
    if payload != "" { return payload }
    payload = This.policyPayloadGeneric(name, "Atomic")
    if payload != "" { return payload }
    payload = This.policyPayloadAfter(name, "Atomic")
    if payload != "" { return payload }
    payload = This.policyPayloadAfter(name, "Volatile")
    if payload != "" { return payload }
    payload = This.policyPayloadAfter(name, "Ring")
    if payload != "" { return payload }
    payload = This.policyPayloadAfter(name, "Sat")
    if payload != "" { return payload }
    payload = This.policyPayloadAfter(name, "Wide")
    if payload != "" { return payload }
    payload = This.policyPayloadAfter(name, "Exact")
    if payload != "" { return payload }
    payload = This.policyPayloadAfter(name, "Raw")
    if payload != "" { return payload }
    return ""
  }

  pub policyPayloadAfter(name: string, prefix: string) -> string {
    if !This.startsWith(name, prefix) {
      return ""
    }
    let payload = name.slice(prefix.length(), name.length()).toString()
    let normalized = This.lowerPrimitiveName(payload)
    if This.policyPayloadSupported(normalized) {
      return normalized
    }
    return ""
  }

  pub policyPayloadGeneric(name: string, prefix: string) -> string {
    let open: string = prefix + "<"
    if !This.startsWith(name, open) {
      return ""
    }
    if name.length() <= open.length() + 1 {
      return ""
    }
    let end = name.length() - 1
    if name.slice(end, name.length()).toString() != ">" {
      return ""
    }
    let payload = name.slice(open.length(), end).toString()
    if This.policyPayloadSupported(payload) {
      return payload
    }
    return ""
  }

  pub policyPayloadSupported(payload: string) -> bool {
    return This.primitiveNumeric(payload) ||
      payload == "bool" ||
      This.startsWith(payload, "*") ||
      This.startsWith(payload, "const *")
  }

  pub lowerPrimitiveName(name: string) -> string {
    return match name {
      "U8" => "u8"
      "U16" => "u16"
      "U32" => "u32"
      "U64" => "u64"
      "U128" => "u128"
      "U256" => "u256"
      "Usize" => "usize"
      "I8" => "i8"
      "I16" => "i16"
      "I32" => "i32"
      "I64" => "i64"
      "I128" => "i128"
      "I256" => "i256"
      "Isize" => "isize"
      "Bool" => "bool"
      "F16" => "f16"
      "F32" => "f32"
      "F64" => "f64"
      "F128" => "f128"
      _ => ""
    }
  }

  pub startsWith(value: string, prefix: string) -> bool {
    if value.length() < prefix.length() {
      return false
    }
    return value.slice(0, prefix.length()).toString() == prefix
  }
}
