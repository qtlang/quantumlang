      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Write
        returnType: "Result<&{valueType}, MapError>"
        valid: true
      }
    }
    if name == "put" || name == "set" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Put
        returnType: receiverType
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "tryPut" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.TryPut
        returnType: "Result<void, MapError>"
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "remove" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Remove
