    if name == "peek" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Peek
        returnType: "Result<{elementType}, DequeError>"
        valid: true
      }
    }
    return This { receiverType, name, compilerNeeded: false, nativeReady: false }
  }
  arenaLifecycleKind(name: string) -> CoreCollectionMethodKind {
    if name == "zero" { return CoreCollectionMethodKind.Zero }
    if name == "reset" { return CoreCollectionMethodKind.Reset }
    if name == "release" { return CoreCollectionMethodKind.Release }
    if name == "seal" { return CoreCollectionMethodKind.Seal }
    if name == "unseal" { return CoreCollectionMethodKind.Unseal }
    if name == "rewind" { return CoreCollectionMethodKind.Rewind }
    return CoreCollectionMethodKind.Fill
  }
  sliceTypeFor(receiverType: string) -> string {
    if !(receiverType.startsWith("Vec<") ||
         receiverType.startsWith("Array<") ||
         receiverType.startsWith("Arena<")) {
      return "Slice<T>"
    }
    let elementType = This.collectionElementTypeFor(receiverType)
    return "Slice<{elementType}>"
  }
}
