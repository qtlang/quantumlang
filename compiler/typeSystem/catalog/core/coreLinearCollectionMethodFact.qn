  pub arena(receiverType: string, name: string) -> This {
    let elementType = This.collectionElementTypeFor(receiverType)
    if name == "alloc" || name == "add" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Alloc
        returnType: "*{elementType}"
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "tryAlloc" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.TryAlloc
        returnType: "Result<*{elementType}, ArenaError>"
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "allocMany" || name == "pushAll" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.AllocMany
        returnType: "Result<Slice<{elementType}>, ArenaError>"
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "ptr" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Ptr
        returnType: "*{elementType}"
        valid: true
