        valid: true
      }
    }
    if name == "set" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Set
        returnType: "Result<void, ArenaError>"
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "get" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Get
        returnType: elementType
        valid: true
      }
    }
    if name == "put" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Put
        returnType: "void"
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "ref" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Ref
        returnType: "const &{elementType}"
        valid: true
      }
    }
    if name == "refAt" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.RefAt
        returnType: "Result<const &{elementType}, ArenaError>"
        valid: true
      }
    }
    if name == "write" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Write
        returnType: "&{elementType}"
        valid: true
      }
    }
    if name == "writeAt" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.WriteAt
        returnType: "Result<&{elementType}, ArenaError>"
        valid: true
      }
    }
    if name == "fill" || name == "zero" || name == "reset" ||
       name == "release" || name == "seal" || name == "unseal" ||
       name == "rewind" {
      return This {
        receiverType
        name
        kind: arenaLifecycleKind(name)
        returnType: receiverType
        mutatesReceiver: true
        valid: true
      }
    }
    if name == "sub" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Sub
        returnType: "Result<Slice<{elementType}>, ArenaError>"
        valid: true
      }
    }
    if name == "mark" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Mark
        returnType: "i64"
        valid: true
      }
    }
    if name == "has" || name == "hasIndex" {
      return This {
        receiverType
        name
        kind: match name == "hasIndex" {
          true => CoreCollectionMethodKind.HasIndex
          false => CoreCollectionMethodKind.Has
        }
        returnType: "bool"
        valid: true
      }
    }
    if name == "slice" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Slice
        returnType: "Slice<{elementType}>"
