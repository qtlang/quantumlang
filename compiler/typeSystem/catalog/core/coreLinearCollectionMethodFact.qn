    }
    if name == "back" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Back
        returnType: "Result<{elementType}, DequeError>"
        valid: true
      }
    }
    if name == "get" {
      return This {
        receiverType
        name
        kind: CoreCollectionMethodKind.Get
