import core::{FileId}
import source::{SourceSpan}

pub AstProduct {
  fileId: FileId = {}
  arena: AstArena = {}
  declarations: Vec<AstDeclaration> = []
  declarationRowCount: i64 = 0
  functionCount: i64 = 0
  typeCount: i64 = 0
  implCount: i64 = 0
  viewCount: i64 = 0
  roleCount: i64 = 0
  importCount: i64 = 0
  contextCount: i64 = 0
  extractCount: i64 = 0
  extendCount: i64 = 0
  returnCount: i64 = 0
  callCount: i64 = 0
  deterministic: bool = true
}

impl AstProduct {
  pub AstProduct(fileId: FileId) =
    This {
      fileId
      arena: AstArena(fileId)
    }

  pub withFileId(fileId: FileId) -> This {
    return this {
      fileId
      arena: arena.withFileId(fileId)
    }
  }

  pub addNode(node: AstNode) {
    arena.add(node)
  }

  pub setRoot(root: AstNodeId) {
    arena.addRoot(root)
  }

  pub addDiagnostic(span: SourceSpan) {
    arena.addDiagnostic(span)
  }

  pub addDeclaration(declaration: AstDeclaration) {
    declarations.push(declaration)
    declarationRowCount = declarationRowCount + 1
  }
}

impl view AstProduct {
  pub rootCount: i64 => arena.rootCount
  pub nodeCount: i64 => arena.count
  pub diagnosticCount: i64 => arena.diagnosticCount
  pub declarationCount: i64 => declarationRowCount
  pub clean: bool => arena.clean
  pub moduleRoot: bool => rootCount == 1
  pub imports: bool => importCount > 0
  pub functionItems: bool => functionCount > 0
  pub returns: bool => returnCount > 0
  pub calls: bool => callCount > 0
  pub arenaOwned: bool => arena.fileId == fileId && arena.storageAligned

  pub nodeAt(index: i64) -> AstNode {
    arena.nodeAt(index)
  }

  pub declarationAt(index: i64) -> AstDeclaration {
    declarations[index]
  }

  pub valid: bool =>
    fileId.valid &&
    moduleRoot &&
    nodeCount > 0 &&
    declarations.count == declarationCount &&
    arenaOwned &&
    arena.valid &&
    clean &&
    deterministic
}

pub PackageAstProduct {
  files: Vec<AstProduct> = []
  declarations: Vec<AstDeclaration> = []
  nodes: Vec<AstNode> = []
  fileStartNodeRows: Vec<i64> = []
  fileEndNodeRows: Vec<i64> = []
  nodeFileIds: Vec<FileId> = []
  nodeFileRows: Vec<i64> = []
  nodeLocalRows: Vec<i64> = []
  fileRowCount: i64 = 0
  declarationRowCount: i64 = 0
  rootCount: i64 = 0
  nodeCount: i64 = 0
  diagnosticCount: i64 = 0
  functionCount: i64 = 0
  typeCount: i64 = 0
  implCount: i64 = 0
  viewCount: i64 = 0
  roleCount: i64 = 0
  importCount: i64 = 0
  contextCount: i64 = 0
  extractCount: i64 = 0
  extendCount: i64 = 0
  returnCount: i64 = 0
  callCount: i64 = 0
  deterministic: bool = true
}

impl PackageAstProduct {
  pub addFile(product: AstProduct) {
    let fileStartNodeRow = nodeCount
    let declarationIndex: i64 = 0
    while declarationIndex < product.declarationCount {
      declarations.push(product.declarationAt(declarationIndex).withFileId(product.fileId))
      declarationIndex = declarationIndex + 1
    }
    let nodeIndex: i64 = 0
    while nodeIndex < product.nodeCount {
      nodes.push(product.nodeAt(nodeIndex).withFileId(product.fileId))
      nodeFileIds.push(product.fileId)
      nodeFileRows.push(fileRowCount)
      nodeLocalRows.push(nodeIndex)
      nodeIndex = nodeIndex + 1
    }
    fileStartNodeRows.push(fileStartNodeRow)
    fileEndNodeRows.push(fileStartNodeRow + product.nodeCount)
    fileRowCount = fileRowCount + 1
    declarationRowCount = declarationRowCount + product.declarationCount
    rootCount = rootCount + product.rootCount
    nodeCount = nodeCount + product.nodeCount
    diagnosticCount = diagnosticCount + product.diagnosticCount
    functionCount = functionCount + product.functionCount
    typeCount = typeCount + product.typeCount
    implCount = implCount + product.implCount
    viewCount = viewCount + product.viewCount
    roleCount = roleCount + product.roleCount
    importCount = importCount + product.importCount
    contextCount = contextCount + product.contextCount
    extractCount = extractCount + product.extractCount
    extendCount = extendCount + product.extendCount
    returnCount = returnCount + product.returnCount
    callCount = callCount + product.callCount
    files.push(product)
  }
}

impl view PackageAstProduct {
  pub fileCount: i64 => fileRowCount
  pub declarationCount: i64 => declarationRowCount
  pub clean: bool => diagnosticCount == 0
  pub moduleRoot: bool => rootCount == fileCount
  pub imports: bool => importCount > 0
  pub functionItems: bool => functionCount > 0
  pub returns: bool => returnCount > 0
  pub calls: bool => callCount > 0

  pub declarationAt(index: i64) -> AstDeclaration {
    declarations[index]
  }

  pub fileAt(index: i64) -> AstProduct {
    files[index]
  }

  pub fileIdAt(index: i64) -> FileId {
    files[index].fileId
  }

  pub fileRowAtNode(index: i64) -> i64 {
    if index >= 0 && index < nodeFileRows.count {
      return nodeFileRows[index]
    }
    return -1
  }

  pub fileStartNodeRowAtNode(index: i64) -> i64 {
    let fileRow = fileRowAtNode(index)
    if fileRow >= 0 && fileRow < fileStartNodeRows.count {
      return fileStartNodeRows[fileRow]
    }
    return 0
  }

  pub fileEndNodeRowAtNode(index: i64) -> i64 {
    let fileRow = fileRowAtNode(index)
    if fileRow >= 0 && fileRow < fileEndNodeRows.count {
      return fileEndNodeRows[fileRow]
    }
    return nodeCount
  }

  pub fileEndSourceAtNode(index: i64) -> i64 {
    let fileRow = fileRowAtNode(index)
    if fileRow < 0 || fileRow >= fileEndNodeRows.count {
      return nodeAt(index).span.end
    }
    let endNodeRow = fileEndNodeRows[fileRow] - 1
    if endNodeRow >= 0 && endNodeRow < nodes.count {
      return nodes[endNodeRow].span.end
    }
    return nodeAt(index).span.end
  }

  pub nodeAt(index: i64) -> AstNode {
    if index >= 0 && index < nodes.count {
      return nodes[index]
    }
    return AstNode(0, AstNodeKind.Unknown, SourceSpan(), 0)
  }

  pub declarationCountFor(kind: AstDeclarationKind) -> i64 {
    let count: i64 = 0
    let index: i64 = 0
    while index < declarationCount {
      if declarationAt(index).kind == kind {
        count = count + 1
      }
      index = index + 1
    }
    return count
  }

  pub firstDeclarationName(kind: AstDeclarationKind) -> string {
    let index: i64 = 0
    while index < declarationCount {
      let declaration = declarationAt(index)
      if declaration.kind == kind {
        return declaration.name
      }
      index = index + 1
    }
    return ""
  }

  pub firstDeclarationModulePath(kind: AstDeclarationKind) -> string {
    let index: i64 = 0
    while index < declarationCount {
      let declaration = declarationAt(index)
      if declaration.kind == kind {
        return declaration.modulePath
      }
      index = index + 1
    }
    return ""
  }

  pub valid: bool =>
    fileCount > 0 &&
    rootCount == fileCount &&
    nodeCount >= rootCount &&
    nodes.count == nodeCount &&
    fileStartNodeRows.count == fileCount &&
    fileEndNodeRows.count == fileCount &&
    nodeFileIds.count == nodeCount &&
    nodeFileRows.count == nodeCount &&
    nodeLocalRows.count == nodeCount &&
    declarations.count == declarationCount &&
    clean &&
    deterministic
}
