import core::{Vec}
import source::{SourceSpan}
import syntax::token::{Trivia}

pub SourceParserToken {
  input: LexProduct = {}
}

impl SourceParserToken {
  pub SourceParserToken(input: LexProduct) =
    This { input }

  receiverSegmentToken(index: i64) -> bool {
    if index < 0 || index >= input.tokenCount {
      return false
    }
    let token = input.tokenAt(index)
    if token.kind.identifierToken {
      return true
    }
    return token.text != "" &&
      !token.text.startsWith("\"") &&
      !token.text.startsWith("'") &&
      token.text != "." &&
      token.text != "(" &&
      token.text != ")" &&
      token.text != "[" &&
      token.text != "]" &&
      token.text != "<" &&
      token.text != ">" &&
      token.text != "{" &&
      token.text != "}" &&
      token.text != "," &&
      token.text != ":" &&
      token.text != ";"
  }

  pub memberReceiverPathAt(index: i64) -> Vec<string> {
    let inlinePath = this.inlineReceiverPathAt(index)
    if inlinePath.count > 0 {
      let prefix = this.memberReceiverPrefixPathAt(index)
      if prefix.count > 0 {
        let combined: Vec<string> = []
        let prefixRow: i64 = 0
        while prefixRow < prefix.count {
          combined.push(prefix[prefixRow])
          prefixRow = prefixRow + 1
        }
        let inlineRow: i64 = 0
        while inlineRow < inlinePath.count {
          combined.push(inlinePath[inlineRow])
          inlineRow = inlineRow + 1
        }
        return combined
      }
      return inlinePath
    }

    let start = index
    while start >= 2 && input.tokenAt(start - 1).text == "." {
      let left = start - 2
      if receiverSegmentToken(left) {
        start = left
      } else if input.tokenAt(left).text == "]" {
        let open = this.matchingOpenToken(left, "[", "]")
        if open <= 0 || !receiverSegmentToken(open - 1) {
          break
        }
        start = open - 1
      } else if input.tokenAt(left).text == ">" {
        let open = this.matchingOpenToken(left, "<", ">")
        if open <= 0 || !receiverSegmentToken(open - 1) {
          break
        }
        start = open - 1
      } else {
        break
      }
    }
    if start < 0 || start == index {
      return []
    }
    let path: Vec<string> = []
    let cursor = start
    while cursor < index {
      let token = input.tokenAt(cursor)
      if !receiverSegmentToken(cursor) {
        return []
      }
      let segment = token.text
      cursor = cursor + 1
      if cursor < index && input.tokenAt(cursor).text == "[" {
        let close = this.matchingCloseToken(cursor, "[", "]")
        if close < 0 || close >= index {
          return []
        }
        segment = "{segment}[]"
        cursor = close + 1
      }
      if cursor < index && input.tokenAt(cursor).text == "<" {
        let close = this.matchingCloseToken(cursor, "<", ">")
        if close < 0 || close >= index {
          return []
        }
        cursor = close + 1
      }
      path.push(segment)
      if cursor < index {
        if input.tokenAt(cursor).text != "." {
          return []
        }
        cursor = cursor + 1
      }
    }
    return path
  }

  memberReceiverPrefixPathAt(index: i64) -> Vec<string> {
    if index < 2 || input.tokenAt(index - 1).text != "." {
      return []
    }
    let prefixEnd = index - 1
    let start = index - 2
    while start >= 2 && input.tokenAt(start - 1).text == "." {
      let left = start - 2
      if receiverSegmentToken(left) {
        start = left
      } else if input.tokenAt(left).text == "]" {
        let open = this.matchingOpenToken(left, "[", "]")
        if open <= 0 || !receiverSegmentToken(open - 1) {
          break
        }
        start = open - 1
      } else if input.tokenAt(left).text == ">" {
        let open = this.matchingOpenToken(left, "<", ">")
        if open <= 0 || !receiverSegmentToken(open - 1) {
          break
        }
        start = open - 1
      } else {
        break
      }
    }

    let path: Vec<string> = []
    let cursor = start
    while cursor < prefixEnd {
      let token = input.tokenAt(cursor)
      if !receiverSegmentToken(cursor) {
        return []
      }
      let segment = token.text
      cursor = cursor + 1
      if cursor < prefixEnd && input.tokenAt(cursor).text == "[" {
        let close = this.matchingCloseToken(cursor, "[", "]")
        if close < 0 || close >= prefixEnd {
          return []
        }
        segment = "{segment}[]"
        cursor = close + 1
      }
      if cursor < prefixEnd && input.tokenAt(cursor).text == "<" {
        let close = this.matchingCloseToken(cursor, "<", ">")
        if close < 0 || close >= prefixEnd {
          return []
        }
        cursor = close + 1
      }
      path.push(segment)
      if cursor < prefixEnd {
        if input.tokenAt(cursor).text != "." {
          return []
        }
        cursor = cursor + 1
      }
    }
    return path
  }

  pub inlineReceiverPathAt(index: i64) -> Vec<string> {
    if index < 0 || index >= input.tokenCount {
      return []
    }
    let token = input.tokenAt(index)
    let dot: i64 = token.text.lastIndexOf(".")
    if dot <= 0 || dot + 1 >= token.text.length() {
      return []
    }

    let path: Vec<string> = []
    let cursor: i64 = 0
    while cursor < dot {
      let segmentEnd = cursor
      while segmentEnd < dot &&
            token.text.slice(segmentEnd, segmentEnd + 1).toString() != "." {
        segmentEnd = segmentEnd + 1
      }
      if segmentEnd == cursor {
        return []
      }
      path.push(token.text.slice(cursor, segmentEnd).toString())
      cursor = segmentEnd + 1
    }
    return path
  }

  matchingOpenToken(closeIndex: i64, openText: string, closeText: string) -> i64 {
    let open = closeIndex
    let depth: i64 = 0
    while open >= 0 {
      let text = input.tokenAt(open).text
      if text == closeText {
        depth = depth + 1
      } else if text == openText {
        depth = depth - 1
        if depth == 0 {
          return open
        }
      }
      open = open - 1
    }
    return -1
  }

  matchingCloseToken(openIndex: i64, openText: string, closeText: string) -> i64 {
    let close = openIndex
    let depth: i64 = 0
    while close < input.tokenCount {
      let text = input.tokenAt(close).text
      if text == openText {
        depth = depth + 1
      } else if text == closeText {
        depth = depth - 1
        if depth == 0 {
          return close
        }
      }
      close = close + 1
    }
    return -1
  }

  pub declarationSpanAt(index: i64) -> SourceSpan {
    if index < 0 || index >= input.tokenCount {
      return SourceSpan()
    }
    let token = input.tokenAt(index)
    let open = index + 1
    while open < input.tokenCount {
      let text = input.tokenAt(open).text
      if text == "{" {
        let close = this.matchingCloseToken(open, "{", "}")
        if close >= 0 {
          return SourceSpan(
            token.span.fileId,
            token.span.start,
            input.tokenAt(close).span.end
          )
        }
        return SourceSpan(token.span.fileId, token.span.start, input.tokenAt(open).span.end)
      }
      if text == "\n" || text == ";" {
        return SourceSpan(token.span.fileId, token.span.start, input.tokenAt(open).span.end)
      }
      open = open + 1
    }
    return token.span
  }

  pub receiverPathName(path: Vec<string>) -> string {
    let result = ""
    let index: i64 = 0
    while index < path.count {
      if result != "" {
        result = "{result}."
      }
      result = "{result}{path[index]}"
      index = index + 1
    }
    return result
  }

  pub nodeTextAt(index: i64) -> string {
    let token = input.tokenAt(index)
    if token.kind.role == TokenRole.Operator {
      return token.text
    }
    if (token.kind.keyword == KeywordKind.Let ||
        token.kind.keyword == KeywordKind.Const) &&
       index + 1 < input.tokenCount {
      return input.tokenAt(index + 1).text
    }
    let dot: i64 = token.text.lastIndexOf(".")
    if dot >= 0 && dot + 1 < token.text.length() {
      return token.text.slice(dot + 1, token.text.length()).toString()
    }
    return token.text
  }

  pub tokensSeparatedByLineBreak(
    leftIndex: i64,
    rightIndex: i64
  ) -> bool {
    if leftIndex < 0 || rightIndex >= input.tokenCount {
      return false
    }

    let leftEnd = input.tokenAt(leftIndex).end
    let rightStart = input.tokenAt(rightIndex).start
    let row: i64 = 0
    while row < input.triviaCount {
      let trivia: Trivia = input.trivia.triviaAt(row)
      if trivia.start > rightStart {
        return false
      }
      if trivia.start >= leftEnd &&
         trivia.end <= rightStart &&
         (trivia.linePreserving || trivia.text.contains("\n")) {
        return true
      }
      row = row + 1
    }
    return false
  }
}
