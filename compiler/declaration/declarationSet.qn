import core::{DeclarationId}

pub DeclarationSet {
  kind: DeclarationKind
  records: Range<DeclarationRecord> = Range<DeclarationRecord>()
  declarations: Range<DeclarationId> = Range<DeclarationId>()
  publicRecords: Range<DeclarationRecord> = Range<DeclarationRecord>()
  publicDeclarations: Range<DeclarationId> = Range<DeclarationId>()
  unresolvedRecords: Range<DeclarationRecord> = Range<DeclarationRecord>()
  unresolvedDeclarations: Range<DeclarationId> = Range<DeclarationId>()
  deterministic: bool = true
}

impl DeclarationSet {
  pub DeclarationSet(kind: DeclarationKind, count: i64) =
    This {
      kind
      records: Range(0, count)
      declarations: Range(0, count)
      publicRecords: Range(0, count)
      publicDeclarations: Range(0, count)
      unresolvedRecords: Range<DeclarationRecord>()
      unresolvedDeclarations: Range<DeclarationId>()
    }

  pub fromRecordSlices(
    kind: DeclarationKind,
    records: Range<DeclarationRecord>,
    declarations: Range<DeclarationId>,
    publicRecords: Range<DeclarationRecord>,
    publicDeclarations: Range<DeclarationId>,
    unresolvedRecords: Range<DeclarationRecord>,
    unresolvedDeclarations: Range<DeclarationId>
  ) =
    This {
      kind
      records
      declarations
      publicRecords
      publicDeclarations
      unresolvedRecords
      unresolvedDeclarations
    }

  pub fromSlices(
    kind: DeclarationKind,
    declarations: Range<DeclarationId>,
    publicDeclarations: Range<DeclarationId>,
    unresolvedDeclarations: Range<DeclarationId>
  ) -> This {
    let records: Range<DeclarationRecord> =
      if declarations.count == 0 {
        Range<DeclarationRecord>()
      } else {
        Range<DeclarationRecord>(declarations.start - 1, declarations.count)
      }

    let publicRecords: Range<DeclarationRecord> =
      if publicDeclarations.count == 0 {
        Range<DeclarationRecord>()
      } else {
        Range<DeclarationRecord>(publicDeclarations.start - 1, publicDeclarations.count)
      }

    let unresolvedRecords: Range<DeclarationRecord> =
      if unresolvedDeclarations.count == 0 {
        Range<DeclarationRecord>()
      } else {
        Range<DeclarationRecord>(unresolvedDeclarations.start - 1, unresolvedDeclarations.count)
      }

    return This {
      kind
      records
      declarations
      publicRecords
      publicDeclarations
      unresolvedRecords
      unresolvedDeclarations
    }
  }
}

impl view DeclarationSet {
  pub count: i64 => records.count

  pub publicCount: i64 => publicRecords.count

  pub unresolvedCount: i64 => unresolvedRecords.count

  pub empty => count == 0

  pub present => count > 0

  pub resolved => unresolvedCount == 0

  pub publicReady => publicCount >= 0 && publicCount <= count

  pub rangesValid =>
    records.start >= 0 &&
    records.count >= 0 &&
    declarations.start >= 0 &&
    declarations.count >= 0 &&
    publicRecords.start >= 0 &&
    publicRecords.count >= 0 &&
    publicDeclarations.start >= 0 &&
    publicDeclarations.count >= 0 &&
    unresolvedRecords.start >= 0 &&
    unresolvedRecords.count >= 0 &&
    unresolvedDeclarations.start >= 0 &&
    unresolvedDeclarations.count >= 0

  pub countsConsistent =>
    count >= 0 &&
    publicCount >= 0 &&
    unresolvedCount >= 0 &&
    publicCount <= count &&
    declarations.count == count &&
    publicDeclarations.count == publicCount &&
    unresolvedDeclarations.count == unresolvedCount

  pub valid =>
    deterministic &&
    rangesValid &&
    countsConsistent &&
    resolved &&
    kind != DeclarationKind.Unknown
}
