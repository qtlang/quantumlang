pub enum RelocationModel {
  Unknown
  Static
  PositionIndependent
  DynamicNoPic
}

impl view RelocationModel {
  pub name: string => match this {
    Unknown => "unknown"
    Static => "static"
    PositionIndependent => "pic"
    DynamicNoPic => "dynamic-no-pic"
  }

  pub known: bool => this != RelocationModel.Unknown
}
