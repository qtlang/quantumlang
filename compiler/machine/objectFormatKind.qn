pub enum ObjectFormatKind {
  Unknown
  Elf
  Coff
  Macho
  Wasm
  Qobj
}

impl view ObjectFormatKind {
  pub name: string => match this {
    Unknown => "unknown"
    Elf => "elf"
    Coff => "coff"
    Macho => "macho"
    Wasm => "wasm"
    Qobj => "qobj"
  }

  pub known: bool => this != ObjectFormatKind.Unknown
}
